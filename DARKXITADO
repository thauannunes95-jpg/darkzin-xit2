-- Diagnóstico de Inicialização
local function Diagnostic()
    local success, err = pcall(function()
        print("[DARKZIN XIT] Verificando ambiente Delta...")
        if game:GetService("CoreGui") then
            print("[DARKZIN XIT] CoreGui acessível. Interface injetada com sucesso.")
        end
    end)
    if not success then
        warn("[DARKZIN XIT] Erro no diagnóstico: " .. tostring(err))
    end
end

Diagnostic()

-- Core Logic Loops
game:GetService("RunService").Heartbeat:Connect(function()
    local lp = game.Players.LocalPlayer
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    -- Aimbot Logic
    if Settings.Aimbot then
        local target = nil
        local dist = math.huge
        for _, v in pairs(game.Players:GetPlayers()) do
            if v ~= lp and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                local d = (char.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
                if d < dist then dist = d; target = v end
            end
        end
        if target then
            game:GetService("Workspace").CurrentCamera.CFrame = CFrame.new(game:GetService("Workspace").CurrentCamera.CFrame.Position, target.Character.HumanoidRootPart.Position)
        end
    end

    -- ESP Logic
    if Settings.ESP then
        for _, v in pairs(game.Players:GetPlayers()) do
            if v ~= lp and v.Character then
                local head = v.Character:FindFirstChild("Head")
                if head then
                    local bill = head:FindFirstChild("ESPBill") or Instance.new("BillboardGui", head)
                    bill.Name = "ESPBill"
                    bill.Size = UDim2.new(0, 100, 0, 50)
                    bill.Adornee = head
                    bill.AlwaysOnTop = true
                    bill.ExtentsOffset = Vector3.new(0, 2, 0)
                    
                    local label = bill:FindFirstChild("TextLabel") or Instance.new("TextLabel", bill)
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Text = v.Name
                    label.TextColor3 = COLORS.Text
                    label.Font = Enum.Font.GothamBold
                    
                    -- Role Detection (Simulated based on MM2 common patterns)
                    if v.Character:FindFirstChild("Knife") then 
                        label.TextColor3 = COLORS.Murderer
                        label.Text = v.Name .. " [MURDERER]"
                    elseif v.Character:FindFirstChild("Gun") then
                        label.TextColor3 = COLORS.Sheriff
                        label.Text = v.Name .. " [SHERIFF]"
                    else
                        label.TextColor3 = COLORS.Innocent
                        label.Text = v.Name .. " [INNOCENT]"
                    end
                end
            end
        end
    else
        for _, v in pairs(game.Players:GetPlayers()) do
            if v.Character and v.Character:FindFirstChild("Head") and v.Character.Head:FindFirstChild("ESPBill") then
                v.Character.Head.ESPBill:Destroy()
            end
        end
    end

    -- Auto Arm Logic
    if Settings.AutoArm then
        for _, item in pairs(game.Workspace:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Gun" or item.Name == "Knife") then
                local hrp = char.HumanoidRootPart
                if (item.Handle.Position - hrp.Position).Magnitude < 15 then
                    firetouchinterest(hrp, item.Handle, 0)
                    firetouchinterest(hrp, item.Handle, 1)
                end
            end
        end
    end
end)
