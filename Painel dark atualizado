CreateOption("Auto Sheriff (Status)", function()
    local lp = game.Players.LocalPlayer
    local tool = lp.Backpack:FindFirstChild("Sheriff") or (lp.Character and lp.Character:FindFirstChild("Sheriff"))
    if tool then
        local selection = Instance.new("SelectionBox")
        selection.Adornee = tool
        selection.Color3 = Color3.new(0, 1, 0)
        selection.Parent = tool
        task.wait(1)
        selection:Destroy()
    end
end)

